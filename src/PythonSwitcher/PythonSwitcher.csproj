<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PythonSwitcher.Core\PythonSwitcher.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.0</Version>
    <!-- Programmsymbol „Weiche“; neu erzeugen mit Assets\make-icon.ps1 -->
    <ApplicationIcon>Assets\PythonSwitcher.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Für Titelleiste und Taskleiste der Fenster -->
    <Resource Include="Assets\PythonSwitcher.ico" />
    <None Remove="Assets\make-icon.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nur für das Weitergabe-Paket, nicht für den normalen Build -->
    <None Include="README.txt" CopyToOutputDirectory="Never" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="Never" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!--
    Weitergabe-Paket: dotnet publish src\PythonSwitcher -p:PublishProfile=Dist
    Danach liegt PythonSwitcher.zip (Ordner PythonSwitcher\ mit EXE, README.txt und LICENSE) auf dem Desktop.
  -->
  <PropertyGroup>
    <DistDesktop>$([System.Environment]::GetFolderPath(SpecialFolder.DesktopDirectory))</DistDesktop>
    <DistStage>$(BaseIntermediateOutputPath)dist\</DistStage>
  </PropertyGroup>

  <Target Name="DistZipToDesktop" AfterTargets="Publish" Condition="'$(DistZip)' == 'true'">
    <ItemGroup>
      <DistFiles Include="$(PublishDir)PythonSwitcher.exe;$(PublishDir)README.txt;$(PublishDir)LICENSE" />
    </ItemGroup>
    <RemoveDir Directories="$(DistStage)" />
    <Copy SourceFiles="@(DistFiles)" DestinationFolder="$(DistStage)PythonSwitcher\" />
    <ZipDirectory SourceDirectory="$(DistStage)" DestinationFile="$(DistDesktop)\PythonSwitcher.zip" Overwrite="true" />
    <Message Importance="high" Text="Weitergabe-Paket: $(DistDesktop)\PythonSwitcher.zip" />
  </Target>

</Project>
