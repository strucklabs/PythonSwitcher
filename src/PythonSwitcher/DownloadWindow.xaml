<Window x:Class="PythonSwitcher.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download" Height="520" Width="640" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox x:Name="ShowAll" DockPanel.Dock="Top" Margin="0,0,0,8" Content="Show all versions (otherwise only the latest of each version series)"
                  Checked="ShowAll_Changed" Unchecked="ShowAll_Changed" />

        <StackPanel DockPanel.Dock="Bottom">
            <ProgressBar x:Name="Progress" Height="14" Margin="0,8,0,6" Minimum="0" Maximum="1" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="InstallButton" Content="Download and install" FontWeight="SemiBold" Click="Install_Click" IsEnabled="False" />
                <Button x:Name="CloseButton" Content="Close" Click="Close_Click" Margin="0,0,0,8" />
            </StackPanel>
        </StackPanel>

        <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Version" Width="110" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="Note" Width="390" DisplayMemberBinding="{Binding Note}" />
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanInstall}" Value="False">
                            <Setter Property="Foreground" Value="#999" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</Window>
