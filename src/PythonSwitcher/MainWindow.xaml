<Window x:Class="PythonSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PythonSwitcher" Height="560" Width="920" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <DockPanel>
                <Button x:Name="UndoButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="Undo_Click"
                        Content="Letzte PATH-Änderung rückgängig"
                        ToolTip="Spielt die zuletzt angelegte Sicherung des PATH zurück. Vor jeder Änderung legt das Programm automatisch eine Sicherung an." />
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="OpenBackups_Click" Content="Sicherungen öffnen" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
        <TabControl x:Name="Tabs" Margin="0,0,0,8" />
    </DockPanel>
</Window>
