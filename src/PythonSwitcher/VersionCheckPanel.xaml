<UserControl x:Class="PythonSwitcher.VersionCheckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                       Text="Shows what is installed around Python (Python, Git, tools, editors, languages and pip packages) and what has a newer version. Nothing is changed, it only displays information. The check needs an internet connection and takes about a minute, depending on the number of Python versions." />
            <WrapPanel>
                <Button x:Name="CheckButton" Content="Check for updates" FontWeight="SemiBold" Click="Check_Click" />
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False" />
                <CheckBox x:Name="OnlyUpdates" Content="Show only entries with updates" VerticalAlignment="Center" Margin="8,0,0,8"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
            </WrapPanel>
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" />
        </StackPanel>

        <ListView x:Name="List" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ContextMenuOpening="List_ContextMenuOpening">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RecheckItem" Header="Check this entry again" Click="Recheck_Click" />
                    <MenuItem x:Name="DryRunItem" Header="Test update (dry run)" Click="DryRun_Click" />
                    <MenuItem x:Name="CopyCommandItem" Header="Copy update command" Click="CopyCommand_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="190" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Installed" Width="110" DisplayMemberBinding="{Binding Installed}" />
                    <GridViewColumn Header="Latest" Width="90" DisplayMemberBinding="{Binding Latest}" />
                    <GridViewColumn Header="Status" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Hint" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontWeight="Normal" />
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontWeight="Normal" Foreground="#8A6D00">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
