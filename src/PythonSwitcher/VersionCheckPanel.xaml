<UserControl x:Class="PythonSwitcher.VersionCheckPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                       Text="Zeigt, was rund um Python installiert ist (Python, Git, Werkzeuge, Editoren, Sprachen und pip-Pakete) und wofür es eine neuere Version gibt. Es wird nur angezeigt, nichts verändert. Für die Prüfung ist eine Internetverbindung nötig; sie dauert je nach Anzahl der Python-Versionen etwa eine Minute." />
            <WrapPanel>
                <Button x:Name="CheckButton" Content="Nach Updates suchen" FontWeight="SemiBold" Click="Check_Click" />
                <Button x:Name="CancelButton" Content="Abbrechen" Click="Cancel_Click" IsEnabled="False" />
                <CheckBox x:Name="OnlyUpdates" Content="Nur Einträge mit Update anzeigen" VerticalAlignment="Center" Margin="8,0,0,8"
                          Checked="Filter_Changed" Unchecked="Filter_Changed" />
            </WrapPanel>
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" />
        </StackPanel>

        <ListView x:Name="List" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="0,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Hinweis kopieren" Click="CopyHint_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="190" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Installiert" Width="110" DisplayMemberBinding="{Binding Installed}" />
                    <GridViewColumn Header="Neueste" Width="90" DisplayMemberBinding="{Binding Latest}" />
                    <GridViewColumn Header="Status" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Hinweis" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontWeight="Normal" />
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontWeight="Normal" Foreground="#8A6D00">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
