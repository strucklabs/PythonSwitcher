<UserControl x:Class="PythonSwitcher.ToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="ActiveText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ActiveDetail" Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,0" />
            <Border x:Name="WarningBox" Background="#FFF4CE" BorderBrush="#E8C547" BorderThickness="1"
                    Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
            <Button x:Name="ActivateButton" Content="Aktivieren" FontWeight="SemiBold" Click="Activate_Click"
                    ToolTip="Stellt die gewählte Version im PATH nach vorn. Gilt für neu geöffnete Terminals und Programme." />
            <Button Content="Ordner hinzufügen …" Click="AddFolder_Click"
                    ToolTip="Eine Installation, die nicht automatisch gefunden wurde, über ihren Ordner aufnehmen." />
            <Button Content="Herunterladen …" Click="Download_Click"
                    ToolTip="Eine offizielle Version herunterladen und installieren." />
            <Button x:Name="RemoveButton" Content="Entfernen …" Click="Remove_Click" />
            <Button x:Name="OpenButton" Content="Ordner öffnen" Click="Open_Click" />
            <Button Content="Neu suchen" Click="Scan_Click"
                    ToolTip="Sucht erneut nach installierten Versionen und liest die Versionsnummern neu ein." />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Hinweis: Änderungen am PATH gelten für Terminals und Programme, die danach gestartet werden. Bereits geöffnete Fenster behalten ihren bisherigen Stand." />

        <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                  MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding StatusText}" />
                    <GridViewColumn Header="Version" Width="140" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="Herkunft" Width="130" DisplayMemberBinding="{Binding SourceText}" />
                    <GridViewColumn Header="Ordner" Width="460" DisplayMemberBinding="{Binding Root}" />
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Missing}" Value="True">
                            <Setter Property="Foreground" Value="#999" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</UserControl>
