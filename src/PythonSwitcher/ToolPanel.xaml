<UserControl x:Class="PythonSwitcher.ToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="ActiveText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ActiveDetail" Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock x:Name="PyDefaultText" Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"
                       ToolTip="The &quot;py&quot; command (Python launcher) is not controlled by the PATH order. It uses its own default, shown here." />
            <Border x:Name="WarningBox" Background="#FFF4CE" BorderBrush="#E8C547" BorderThickness="1"
                    Padding="8,6" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
            <Button x:Name="ActivateButton" Content="Activate" FontWeight="SemiBold" Click="Activate_Click"
                    ToolTip="Moves the selected version to the front of the PATH. Applies to newly opened terminals and programs." />
            <Button Content="Add folder …" Click="AddFolder_Click"
                    ToolTip="Add an installation that was not found automatically by selecting its folder." />
            <Button Content="Download …" Click="Download_Click"
                    ToolTip="Download and install an official version." />
            <Button x:Name="RemoveButton" Content="Remove …" Click="Remove_Click" />
            <Button x:Name="OpenButton" Content="Open folder" Click="Open_Click" />
            <Button Content="Search again" Click="Scan_Click"
                    ToolTip="Searches for installed versions again and re-reads the version numbers." />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Note: PATH changes apply to terminals and programs started afterwards. Windows that are already open keep their previous state." />

        <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged"
                  MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding StatusText}" />
                    <GridViewColumn Header="Version" Width="140" DisplayMemberBinding="{Binding Version}" />
                    <GridViewColumn Header="Source" Width="130" DisplayMemberBinding="{Binding SourceText}" />
                    <GridViewColumn Header="Folder" Width="460" DisplayMemberBinding="{Binding Root}" />
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Missing}" Value="True">
                            <Setter Property="Foreground" Value="#999" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </DockPanel>
</UserControl>
